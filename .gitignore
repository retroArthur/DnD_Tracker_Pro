# Environment
.env
.env.local
tests/e2e/test-results/
tests/e2e/test-results-smoke/
tests/e2e/reports/
# Playwright legt seinen Ausgabeordner relativ zum AUFRUFORT an, nicht
# relativ zur Konfiguration. Ein Lauf ohne --config (oder aus einem anderen
# Verzeichnis) erzeugt deshalb test-results/ in der Wurzel, obwohl beide
# Konfigurationen nach tests/e2e/ zeigen. Der fuehrende Schraegstrich bindet
# den Eintrag genau an die Wurzel und laesst die beiden Ordner darueber
# unberuehrt. Nur loeschen liesse ihn wiederkommen, nur ignorieren verbaerge
# den Hinweis, dass jemand ohne Konfiguration geprueft hat.
/test-results/
# Ablichtungen der Sichtpruefung (welle-1-screens.spec.js mit
# WELLE1_SCREENS=1, welle-2-screens.spec.js mit WELLE2_SCREENS=1):
# oertliches Material fuer die menschliche Runde, jederzeit neu erzeugbar —
# ein Stapel Vollbilder gehoert nicht in die Historie.
tests/e2e/__screens__/
tmpclaude-*
__pycache__/
.pytest_cache/
*.backup

# Lokale Kampagnendaten (beim Umzug 2026-08-25 mitgenommen, nicht versioniert)
Daten/

# Rohmaterial fuer das Soundboard (7,6 MB Audiodateien). Bewusst nicht
# versioniert: die App laedt Klaenge zur Laufzeit in IndexedDB, das Repo
# braucht sie nicht, und jeder Klon zoege sie mit.
Ablage/
